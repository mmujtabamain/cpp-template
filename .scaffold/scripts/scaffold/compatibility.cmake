include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/utils.cmake")

# Validate versions against an explicitly supplied manifest and running version.
# OUTPUT: versions record {cmake_version, cmake_major, cmake_minor, cmake_patch,
#                          cpp_version, cpp_feature, use_presets, preset_schema}.
function(scaffold_reject_compatibility OPTIONS REASON)
    message(FATAL_ERROR "${REASON}\n\n${OPTIONS}")
endfunction()

function(scaffold_resolve_compatibility)
    cmake_parse_arguments(PARSE_ARGV 0 ARG ""
        "MANIFEST;CMAKE_VERSION;CPP_VERSION;RUNNING_CMAKE_VERSION;OUTPUT" "")
    scaffold_require_value("MANIFEST" "${ARG_MANIFEST}")
    scaffold_require_value("RUNNING_CMAKE_VERSION" "${ARG_RUNNING_CMAKE_VERSION}")
    scaffold_require_value("OUTPUT" "${ARG_OUTPUT}")
    file(READ "${ARG_MANIFEST}" COMPATIBILITY)
    set(RUNNING_CMAKE_VERSION "${ARG_RUNNING_CMAKE_VERSION}")
    set(PROJECT_CMAKE_VERSION "${ARG_CMAKE_VERSION}")
    if(PROJECT_CMAKE_VERSION STREQUAL "")
        set(PROJECT_CMAKE_VERSION "${RUNNING_CMAKE_VERSION}")
    endif()
    if(NOT PROJECT_CMAKE_VERSION MATCHES "^[1-9][0-9]*\\.(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*))?$")
        message(FATAL_ERROR "CMake version must be major.minor or major.minor.patch.")
    endif()
    string(REPLACE "." ";" VERSION_PARTS "${PROJECT_CMAKE_VERSION}")
    list(GET VERSION_PARTS 0 PROJECT_CMAKE_MAJOR)
    list(GET VERSION_PARTS 1 PROJECT_CMAKE_MINOR)
    list(LENGTH VERSION_PARTS PART_COUNT)
    set(PROJECT_CMAKE_PATCH 0)
    if(PART_COUNT EQUAL 3)
        list(GET VERSION_PARTS 2 PROJECT_CMAKE_PATCH)
    endif()
    set(PROJECT_CMAKE_VERSION "${PROJECT_CMAKE_MAJOR}.${PROJECT_CMAKE_MINOR}.${PROJECT_CMAKE_PATCH}")
    set(PROJECT_CPP_VERSION "${ARG_CPP_VERSION}")
    if(PROJECT_CPP_VERSION STREQUAL "")
        set(PROJECT_CPP_VERSION 23)
    endif()
    string(JSON VCPKG_CMAKE_MINIMUM GET "${COMPATIBILITY}" dependencies vcpkgToolchainCmakeMinimum)
    string(JSON FEATURE_CMAKE_MINIMUM GET "${COMPATIBILITY}" dependencies compileFeatureMetaCmakeMinimum)
    string(JSON CPP_COUNT LENGTH "${COMPATIBILITY}" cppStandards)
    math(EXPR CPP_LAST "${CPP_COUNT} - 1")
    set(CPP_SUPPORTED false)
    set(COMPATIBILITY_OPTIONS "Valid C++ options (minimum CMake):")
    foreach(INDEX RANGE 0 ${CPP_LAST})
        string(JSON CPP_STANDARD GET "${COMPATIBILITY}" cppStandards ${INDEX} standard)
        string(JSON STANDARD_MINIMUM GET "${COMPATIBILITY}" cppStandards ${INDEX} cmakeMinimum)
        string(APPEND COMPATIBILITY_OPTIONS "\n  --cpp-version ${CPP_STANDARD}: CMake ${STANDARD_MINIMUM}+")
        if(PROJECT_CPP_VERSION STREQUAL CPP_STANDARD)
            set(CPP_SUPPORTED true)
            string(JSON CPP_MINIMUM GET "${COMPATIBILITY}" cppStandards ${INDEX} cmakeMinimum)
            set(PROJECT_CPP_FEATURE "cxx_std_${PROJECT_CPP_VERSION}")
        endif()
    endforeach()
    # Show choices derived from the same manifest that enforces compatibility.
    string(JSON SERIES_COUNT LENGTH "${COMPATIBILITY}" cmakeSeries)
    math(EXPR SERIES_LAST "${SERIES_COUNT} - 1")
    set(CMAKE_SUPPORTED false)
    set(CMAKE_CHOICES "")
    set(CHOICES_MINIMUM "${FEATURE_CMAKE_MINIMUM}")
    set(CHOICES_LABEL "Valid CMake series")
    if(CPP_SUPPORTED)
        set(CHOICES_MINIMUM "${CPP_MINIMUM}")
        string(APPEND CHOICES_LABEL " for C++${PROJECT_CPP_VERSION}")
    endif()
    set(REQUESTED_SERIES "${PROJECT_CMAKE_MAJOR}.${PROJECT_CMAKE_MINOR}")
    foreach(INDEX RANGE 0 ${SERIES_LAST})
        string(JSON SUPPORTED_SERIES GET "${COMPATIBILITY}" cmakeSeries ${INDEX})
        if(REQUESTED_SERIES STREQUAL SUPPORTED_SERIES)
            set(CMAKE_SUPPORTED true)
        endif()
        if(NOT SUPPORTED_SERIES VERSION_LESS CHOICES_MINIMUM
           AND NOT SUPPORTED_SERIES VERSION_GREATER RUNNING_CMAKE_VERSION)
            list(APPEND CMAKE_CHOICES "${SUPPORTED_SERIES}")
        endif()
    endforeach()
    list(JOIN CMAKE_CHOICES ", " CMAKE_CHOICES)
    string(APPEND COMPATIBILITY_OPTIONS
        "\n\n${CHOICES_LABEL} (--cmake-version, up to running CMake ${RUNNING_CMAKE_VERSION}):\n  ${CMAKE_CHOICES}")

    if(PROJECT_CMAKE_VERSION VERSION_GREATER RUNNING_CMAKE_VERSION)
        scaffold_reject_compatibility("${COMPATIBILITY_OPTIONS}" "Requested CMake ${PROJECT_CMAKE_VERSION} exceeds running CMake ${RUNNING_CMAKE_VERSION}; install it before scaffolding.")
    endif()
    if(PROJECT_CMAKE_VERSION VERSION_LESS VCPKG_CMAKE_MINIMUM OR PROJECT_CMAKE_VERSION VERSION_LESS FEATURE_CMAKE_MINIMUM)
        scaffold_reject_compatibility("${COMPATIBILITY_OPTIONS}" "Generated projects require CMake ${FEATURE_CMAKE_MINIMUM}+ for compile features and the vcpkg toolchain.")
    endif()
    if(NOT CPP_SUPPORTED)
        scaffold_reject_compatibility("${COMPATIBILITY_OPTIONS}" "Unsupported C++ version '${PROJECT_CPP_VERSION}'.")
    endif()
    string(JSON FMT_CPP_MINIMUM GET "${COMPATIBILITY}" dependencies fmtCppMinimum)
    if(PROJECT_CPP_VERSION LESS FMT_CPP_MINIMUM)
        scaffold_reject_compatibility("${COMPATIBILITY_OPTIONS}" "The starter fmt dependency requires C++${FMT_CPP_MINIMUM} or newer.")
    endif()
    if(PROJECT_CMAKE_VERSION VERSION_LESS CPP_MINIMUM)
        scaffold_reject_compatibility("${COMPATIBILITY_OPTIONS}" "C++${PROJECT_CPP_VERSION} requires CMake ${CPP_MINIMUM} or newer in this scaffold.")
    endif()
    if(NOT CMAKE_SUPPORTED)
        scaffold_reject_compatibility("${COMPATIBILITY_OPTIONS}" "Unsupported CMake series: ${REQUESTED_SERIES}.")
    endif()
    string(JSON PRESETS_MINIMUM GET "${COMPATIBILITY}" presets cmakeMinimum)
    string(JSON PROJECT_PRESET_SCHEMA GET "${COMPATIBILITY}" presets schema)
    set(PROJECT_USE_PRESETS ON)
    if(PROJECT_CMAKE_VERSION VERSION_LESS PRESETS_MINIMUM)
        set(PROJECT_USE_PRESETS OFF)
    endif()

    scaffold_json_object(VERSIONS
        cmake_version "${PROJECT_CMAKE_VERSION}"
        cmake_major "${PROJECT_CMAKE_MAJOR}" cmake_minor "${PROJECT_CMAKE_MINOR}" cmake_patch "${PROJECT_CMAKE_PATCH}"
        cpp_version "${PROJECT_CPP_VERSION}" cpp_feature "${PROJECT_CPP_FEATURE}"
        use_presets "${PROJECT_USE_PRESETS}" preset_schema "${PROJECT_PRESET_SCHEMA}")
    set("${ARG_OUTPUT}" "${VERSIONS}" PARENT_SCOPE)
endfunction()
