# The compatibility manifest is the single source of allowed C++/CMake pairs.
file(READ "${SCAFFOLD_ROOT}/compatibility.json" COMPATIBILITY)
if(NOT DEFINED PROJECT_CPP_VERSION OR PROJECT_CPP_VERSION STREQUAL "")
    set(PROJECT_CPP_VERSION 23)
endif()
string(JSON VCPKG_CMAKE_MINIMUM GET "${COMPATIBILITY}" dependencies vcpkgToolchainCmakeMinimum)
string(JSON FEATURE_CMAKE_MINIMUM GET "${COMPATIBILITY}" dependencies compileFeatureMetaCmakeMinimum)
string(JSON CPP_COUNT LENGTH "${COMPATIBILITY}" cppStandards)
math(EXPR CPP_LAST "${CPP_COUNT} - 1")
set(CPP_SUPPORTED false)
set(COMPATIBILITY_OPTIONS "Valid C++ options (minimum CMake):")
foreach(INDEX RANGE 0 ${CPP_LAST})
    string(JSON CPP_STANDARD GET "${COMPATIBILITY}" cppStandards ${INDEX} standard)
    string(JSON STANDARD_MINIMUM GET "${COMPATIBILITY}" cppStandards ${INDEX} cmakeMinimum)
    string(APPEND COMPATIBILITY_OPTIONS "\n  --cpp-version ${CPP_STANDARD}: CMake ${STANDARD_MINIMUM}+")
    if(PROJECT_CPP_VERSION STREQUAL CPP_STANDARD)
        set(CPP_SUPPORTED true)
        string(JSON CPP_MINIMUM GET "${COMPATIBILITY}" cppStandards ${INDEX} cmakeMinimum)
        set(PROJECT_CPP_FEATURE "cxx_std_${PROJECT_CPP_VERSION}")
    endif()
endforeach()
# Show choices derived from the same manifest that enforces compatibility.
string(JSON SERIES_COUNT LENGTH "${COMPATIBILITY}" cmakeSeries)
math(EXPR SERIES_LAST "${SERIES_COUNT} - 1")
set(CMAKE_SUPPORTED false)
set(CMAKE_CHOICES "")
set(CHOICES_MINIMUM "${FEATURE_CMAKE_MINIMUM}")
set(CHOICES_LABEL "Valid CMake series")
if(CPP_SUPPORTED)
    set(CHOICES_MINIMUM "${CPP_MINIMUM}")
    string(APPEND CHOICES_LABEL " for C++${PROJECT_CPP_VERSION}")
endif()
set(REQUESTED_SERIES "${PROJECT_CMAKE_MAJOR}.${PROJECT_CMAKE_MINOR}")
foreach(INDEX RANGE 0 ${SERIES_LAST})
    string(JSON SUPPORTED_SERIES GET "${COMPATIBILITY}" cmakeSeries ${INDEX})
    if(REQUESTED_SERIES STREQUAL SUPPORTED_SERIES)
        set(CMAKE_SUPPORTED true)
    endif()
    if(NOT SUPPORTED_SERIES VERSION_LESS CHOICES_MINIMUM
       AND NOT SUPPORTED_SERIES VERSION_GREATER CMAKE_VERSION)
        list(APPEND CMAKE_CHOICES "${SUPPORTED_SERIES}")
    endif()
endforeach()
list(JOIN CMAKE_CHOICES ", " CMAKE_CHOICES)
string(APPEND COMPATIBILITY_OPTIONS
    "\n\n${CHOICES_LABEL} (--cmake-version, up to running CMake ${CMAKE_VERSION}):\n  ${CMAKE_CHOICES}")

function(reject_compatibility REASON)
    message(FATAL_ERROR "${REASON}\n\n${COMPATIBILITY_OPTIONS}")
endfunction()

if(PROJECT_CMAKE_VERSION VERSION_GREATER CMAKE_VERSION)
    reject_compatibility("Requested CMake ${PROJECT_CMAKE_VERSION} exceeds running CMake ${CMAKE_VERSION}; install it before scaffolding.")
endif()
if(PROJECT_CMAKE_VERSION VERSION_LESS VCPKG_CMAKE_MINIMUM OR PROJECT_CMAKE_VERSION VERSION_LESS FEATURE_CMAKE_MINIMUM)
    reject_compatibility("Generated projects require CMake ${FEATURE_CMAKE_MINIMUM}+ for compile features and the vcpkg toolchain.")
endif()
if(NOT CPP_SUPPORTED)
    reject_compatibility("Unsupported C++ version '${PROJECT_CPP_VERSION}'.")
endif()
string(JSON FMT_CPP_MINIMUM GET "${COMPATIBILITY}" dependencies fmtCppMinimum)
if(PROJECT_CPP_VERSION LESS FMT_CPP_MINIMUM)
    reject_compatibility("The starter fmt dependency requires C++${FMT_CPP_MINIMUM} or newer.")
endif()
if(PROJECT_CMAKE_VERSION VERSION_LESS CPP_MINIMUM)
    reject_compatibility("C++${PROJECT_CPP_VERSION} requires CMake ${CPP_MINIMUM} or newer in this scaffold.")
endif()
if(NOT CMAKE_SUPPORTED)
    reject_compatibility("Unsupported CMake series: ${REQUESTED_SERIES}.")
endif()
string(JSON PRESETS_MINIMUM GET "${COMPATIBILITY}" presets cmakeMinimum)
string(JSON PROJECT_PRESET_SCHEMA GET "${COMPATIBILITY}" presets schema)
set(PROJECT_USE_PRESETS ON)
if(PROJECT_CMAKE_VERSION VERSION_LESS PRESETS_MINIMUM)
    set(PROJECT_USE_PRESETS OFF)
endif()

if(PROJECT_USE_PRESETS)
    file(READ "${TEMPLATE_DIRECTORY}/fragments/build-presets.md" PROJECT_BUILD_GUIDE)
else()
    file(READ "${TEMPLATE_DIRECTORY}/fragments/build-cmake-legacy.md" PROJECT_BUILD_GUIDE)
endif()

# Specialize the generated files once; the new project needs no version branches.
if(PROJECT_USE_PRESETS)
    set(PROJECT_CONFIGURE_ARGUMENTS "set(CONFIGURE_ARGUMENTS --preset \"\${PRESET}\")")
    set(PROJECT_CONFIGURE_DIRECTORY "\${PROJECT_ROOT}")
else()
    file(READ "${TEMPLATE_DIRECTORY}/fragments/configure-direct.cmake.in" PROJECT_CONFIGURE_ARGUMENTS)
    set(PROJECT_CONFIGURE_DIRECTORY "\${PROJECT_ROOT}/build/\${PRESET}")
endif()
set(PROJECT_SOURCE_DISCOVERY_OPTION "CONFIGURE_DEPENDS ")
set(PROJECT_SOURCE_DISCOVERY_GUIDE "New source files are discovered automatically during builds.")
if(PROJECT_CMAKE_VERSION VERSION_LESS "3.12")
    set(PROJECT_SOURCE_DISCOVERY_OPTION "")
    set(PROJECT_SOURCE_DISCOVERY_GUIDE "Rerun setup after adding or removing source files.")
endif()

set(PROJECT_EXECUTABLE_RUN_DIRECTORY "$<TARGET_FILE_DIR:\${PROJECT_NAME}>")
set(PROJECT_LIBRARY_RUN_DIRECTORY "$<TARGET_FILE_DIR:\${PROJECT_NAME}_example>")
if(PROJECT_CMAKE_VERSION VERSION_LESS "3.13")
    set(PROJECT_EXECUTABLE_RUN_DIRECTORY "\${CMAKE_CURRENT_BINARY_DIR}/\${CMAKE_CFG_INTDIR}")
    set(PROJECT_LIBRARY_RUN_DIRECTORY "\${CMAKE_CURRENT_BINARY_DIR}/bin/\${CMAKE_CFG_INTDIR}")
endif()
