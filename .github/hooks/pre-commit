#!/bin/sh
# Git for Windows also runs hooks through its bundled POSIX shell.
# Prefer the same local interpreter used for repository development.
set -eu

repository_root=$(git rev-parse --show-toplevel)
validation_hook="$repository_root/.github/hooks/validate-commit.py"

if [ -x "$repository_root/.venv/bin/python" ]; then
    python_executable="$repository_root/.venv/bin/python"
elif [ -x "$repository_root/.venv/Scripts/python.exe" ]; then
    python_executable="$repository_root/.venv/Scripts/python.exe"
elif command -v python3 >/dev/null 2>&1; then
    python_executable=python3
elif command -v python >/dev/null 2>&1; then
    python_executable=python
else
    if [ "$(git symbolic-ref --quiet --short HEAD)" = main ]; then
        echo "ERROR: Python 3 is required to validate commits to main." >&2
        exit 1
    fi
    echo "WARNING: Python 3 is unavailable; template validation skipped." >&2
    exit 0
fi

exec "$python_executable" "$validation_hook"
