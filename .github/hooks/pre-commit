#!/bin/sh

set -eu

repository_root=$(git rev-parse --show-toplevel)
validation_hook="$repository_root/.github/hooks/scripts/validate-commit.py"

# get python executable [python|python3]
if [ -x "$repository_root/.venv/bin/python" ]; then
    python_executable="$repository_root/.venv/bin/python"
elif [ -x "$repository_root/.venv/Scripts/python.exe" ]; then
    python_executable="$repository_root/.venv/Scripts/python.exe"
elif command -v python3 >/dev/null 2>&1; then
    python_executable=python3
elif command -v python >/dev/null 2>&1; then
    python_executable=python
else
    python_executable=
    echo "Python 3 is required to run template validation." >&2
fi

# if python in path, then
if [ -n "$python_executable" ]; then
    if "$python_executable" "$validation_hook"; then
        exit 0
    fi
fi

# if main branch, exit with -1 to indicate error
if current_branch=$(git symbolic-ref --quiet --short HEAD); then
    if [ "$current_branch" = main ]; then
        echo "ERROR: Template validation failed; commit to main blocked." >&2
        exit 1
    fi
else # if branch not detected, fail to be safe
    branch_status=$?
    if [ "$branch_status" -ne 1 ]; then
        echo "ERROR: Cannot determine the branch for commit validation." >&2
        exit 1
    fi
fi

# for branches other than main, show warning and allow commit
echo "WARNING: Template validation could not complete; commit allowed outside main." >&2
exit 0
