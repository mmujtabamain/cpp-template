# Shared one-time generator for the shell and Batch launchers.
# Render and validate in staging before allowing destructive replacement.
cmake_minimum_required(VERSION 3.24)
get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(TEMPLATES "${ROOT}/.template/templates")
set(STAGE "${ROOT}/.template/.scaffold-tmp")

# Validate every input before touching generated output or the previous staging tree.
if(NOT DEFINED PROJECT_DISPLAY_NAME OR NOT DEFINED PROJECT_TYPE)
    message(FATAL_ERROR "Supply PROJECT_DISPLAY_NAME and PROJECT_TYPE (exec or library).")
endif()
string(STRIP "${PROJECT_DISPLAY_NAME}" PROJECT_DISPLAY_NAME)
if(NOT PROJECT_DISPLAY_NAME MATCHES "^[A-Za-z][A-Za-z0-9 _-]*$")
    message(FATAL_ERROR "Project name must start with a letter and contain only ASCII letters, digits, spaces, underscores or hyphens.")
endif()
string(TOLOWER "${PROJECT_TYPE}" PROJECT_TYPE)
if(NOT PROJECT_TYPE STREQUAL "exec" AND NOT PROJECT_TYPE STREQUAL "library")
    message(FATAL_ERROR "Project type must be exec or library.")
endif()
# Split words at separators and CamelCase/acronym boundaries.
string(REGEX REPLACE "([A-Z]+)([A-Z][a-z])" "\\1_\\2" WORDS "${PROJECT_DISPLAY_NAME}")
string(REGEX REPLACE "([a-z0-9])([A-Z])" "\\1_\\2" WORDS "${WORDS}")
string(REGEX REPLACE "[ _-]+" ";" WORDS "${WORDS}")
# Preserve this placeholder for the generated library's later CMake configure step.
set(PACKAGE_INIT "@PACKAGE_INIT@")
set(PROJECT_NAME "")
set(PROJECT_NAMESPACE "")
foreach(WORD IN LISTS WORDS)
    if(WORD STREQUAL "")
        continue()
    endif()
    string(SUBSTRING "${WORD}" 0 1 FIRST)
    string(TOUPPER "${FIRST}" FIRST)
    string(SUBSTRING "${WORD}" 1 -1 REST)
    string(APPEND PROJECT_NAME "${FIRST}${REST}")
    string(TOLOWER "${WORD}" WORD)
    if(NOT PROJECT_NAMESPACE STREQUAL "")
        string(APPEND PROJECT_NAMESPACE "_")
    endif()
    string(APPEND PROJECT_NAMESPACE "${WORD}")
endforeach()
set(KEYWORDS alignas alignof and and_eq asm auto bitand bitor bool break case catch char char8_t char16_t char32_t class compl concept const consteval constexpr constinit const_cast continue co_await co_return co_yield decltype default delete do double dynamic_cast else enum explicit export extern false float for friend goto if inline int long mutable namespace new noexcept not not_eq nullptr operator or or_eq private protected public register reinterpret_cast requires return short signed sizeof static static_assert static_cast struct switch template this thread_local throw true try typedef typeid typename union unsigned using virtual void volatile wchar_t while xor xor_eq)
set(RESERVED_TARGETS all clean help install test package run)
if(PROJECT_NAMESPACE IN_LIST KEYWORDS OR PROJECT_NAMESPACE MATCHES "^_[A-Za-z_]" OR PROJECT_NAME IN_LIST RESERVED_TARGETS OR PROJECT_NAME STREQUAL "Run")
    message(FATAL_ERROR "Project name normalizes to a reserved C++ or build identifier. Choose another name.")
endif()
string(TOUPPER "${PROJECT_NAMESPACE}" PROJECT_MACRO)
string(REPLACE "_" "-" PROJECT_MANIFEST_NAME "${PROJECT_NAMESPACE}")

# Discard interrupted staging output; existing project files remain untouched here.
file(REMOVE_RECURSE "${STAGE}")
file(MAKE_DIRECTORY "${STAGE}")
# Render common development tools, then the selected project type.
foreach(KIND common "${PROJECT_TYPE}")
    if(KIND STREQUAL "exec")
        set(KIND executable)
    endif()
    file(GLOB_RECURSE INPUTS LIST_DIRECTORIES false RELATIVE "${TEMPLATES}/${KIND}" "${TEMPLATES}/${KIND}/*")
    foreach(INPUT IN LISTS INPUTS)
        set(OUTPUT "${INPUT}")
        # Replace generic library paths with the normalized package and namespace names.
        if(KIND STREQUAL "library")
            string(REPLACE "include/project/project.hpp" "include/${PROJECT_NAMESPACE}/${PROJECT_NAMESPACE}.hpp" OUTPUT "${OUTPUT}")
            string(REPLACE "src/project.cpp" "src/${PROJECT_NAMESPACE}.cpp" OUTPUT "${OUTPUT}")
            string(REPLACE "tests/project_test.cpp" "tests/${PROJECT_NAMESPACE}_test.cpp" OUTPUT "${OUTPUT}")
            string(REPLACE "cmake/ProjectConfig.cmake.in" "cmake/${PROJECT_NAME}Config.cmake.in" OUTPUT "${OUTPUT}")
        endif()
        # The package config remains a CMake input template after scaffolding.
        if(NOT OUTPUT MATCHES "Config\\.cmake\\.in$")
            string(REGEX REPLACE "\\.in$" "" OUTPUT "${OUTPUT}")
        endif()
        configure_file("${TEMPLATES}/${KIND}/${INPUT}" "${STAGE}/${OUTPUT}" @ONLY)
    endforeach()
endforeach()
if(PROJECT_TYPE STREQUAL "exec")
    file(MAKE_DIRECTORY "${STAGE}/assets")
endif()
if(PROJECT_TYPE STREQUAL "exec")
    set(TYPE_REQUIRED src/main.cpp)
else()
    set(TYPE_REQUIRED "include/${PROJECT_NAMESPACE}/${PROJECT_NAMESPACE}.hpp" "src/${PROJECT_NAMESPACE}.cpp"
        examples/main.cpp "tests/${PROJECT_NAMESPACE}_test.cpp" "cmake/${PROJECT_NAME}Config.cmake.in")
endif()
# Check required files and JSON before asking to replace the existing project.
foreach(REQUIRED ${TYPE_REQUIRED} CMakeLists.txt CMakePresets.json vcpkg.json README.md scripts/setup.cmake scripts/run.cmake setup.sh setup.bat run.sh run.bat)
    if(NOT EXISTS "${STAGE}/${REQUIRED}")
        message(FATAL_ERROR "Incomplete staged project: missing ${REQUIRED}. Existing project is untouched.")
    endif()
endforeach()
foreach(JSON CMakePresets.json vcpkg.json)
    file(READ "${STAGE}/${JSON}" CONTENT)
    string(JSON JSON_TYPE ERROR_VARIABLE JSON_ERROR TYPE "${CONTENT}")
    if(NOT JSON_ERROR STREQUAL "NOTFOUND" OR NOT JSON_TYPE STREQUAL "OBJECT")
        message(FATAL_ERROR "Invalid staged ${JSON}: ${JSON_ERROR}. Existing project is untouched.")
    endif()
endforeach()
# Generated Unix launchers must be executable immediately after scaffolding.
file(CHMOD "${STAGE}/setup.sh" "${STAGE}/run.sh" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)

# Only these reserved paths may be replaced; Git, tooling, and unrelated files survive.
set(OWNED CMakeLists.txt CMakePresets.json vcpkg.json README.md src include assets examples tests cmake scripts setup.sh setup.bat run.sh run.bat build vcpkg_installed .github/workflows/validate.yml)
set(EXISTING false)
foreach(PATH IN LISTS OWNED)
    # The template's README and validation workflow also exist before scaffolding.
    if(NOT PATH STREQUAL "README.md" AND NOT PATH STREQUAL ".github/workflows/validate.yml" AND (EXISTS "${ROOT}/${PATH}" OR IS_SYMLINK "${ROOT}/${PATH}"))
        set(EXISTING true)
    endif()
endforeach()
# Ask only after a replacement is ready. EOF and any answer other than yes cancel.
if(EXISTING AND NOT SCAFFOLD_FORCE)
    message("An existing scaffolded project was detected.\n\nRe-scaffolding will permanently erase the existing generated project,\nincluding source files and changes made after scaffolding.\n\nContinue? [y/N]")
    if(CMAKE_HOST_WIN32)
        execute_process(COMMAND powershell -NoProfile -Command "[Console]::ReadLine()" OUTPUT_VARIABLE ANSWER RESULT_VARIABLE PROMPT_RESULT)
    else()
        execute_process(COMMAND sh -c "IFS= read -r answer; printf '%s' \"$answer\"" OUTPUT_VARIABLE ANSWER RESULT_VARIABLE PROMPT_RESULT)
    endif()
    string(STRIP "${ANSWER}" ANSWER)
    string(TOLOWER "${ANSWER}" ANSWER)
    if(NOT PROMPT_RESULT EQUAL 0 OR NOT ANSWER MATCHES "^(y|yes)$")
        file(REMOVE_RECURSE "${STAGE}")
        message("Scaffolding cancelled. Existing project is unchanged.")
        return()
    endif()
endif()
# Only a fully rendered replacement reaches this destructive commit step.
foreach(PATH IN LISTS OWNED)
    file(REMOVE_RECURSE "${ROOT}/${PATH}")
endforeach()
# Move individual files to preserve unrelated content in shared directories such as .github.
file(GLOB_RECURSE OUTPUTS LIST_DIRECTORIES true RELATIVE "${STAGE}" "${STAGE}/*")
foreach(OUTPUT IN LISTS OUTPUTS)
    if(IS_DIRECTORY "${STAGE}/${OUTPUT}")
        file(MAKE_DIRECTORY "${ROOT}/${OUTPUT}")
    else()
        get_filename_component(PARENT "${ROOT}/${OUTPUT}" DIRECTORY)
        file(MAKE_DIRECTORY "${PARENT}")
        file(RENAME "${STAGE}/${OUTPUT}" "${ROOT}/${OUTPUT}")
    endif()
endforeach()
file(REMOVE_RECURSE "${STAGE}")
message(STATUS "Generated ${PROJECT_TYPE}: ${PROJECT_DISPLAY_NAME} (${PROJECT_NAME}, ${PROJECT_NAMESPACE}, ${PROJECT_MANIFEST_NAME})")
message(STATUS "Next: setup.sh / setup.bat, then run.sh / run.bat")
