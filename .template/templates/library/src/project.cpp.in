#include <fmt/core.h>

namespace @PROJECT_NAMESPACE@
{
    int add(int left_value, int right_value)
    {
        const int sum = left_value + right_value;

        fmt::print("{} + {} = {}\n", left_value, right_value, sum);

        return sum;
    }
